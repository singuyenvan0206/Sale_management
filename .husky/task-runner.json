{
   "$schema": "https://alirezanet.github.io/Husky.Net/schema.json",
   "tasks": [
      {
         "name": "check-magic-strings",
         "group": "pre-commit",
         "command": "powershell",
         "args": [ "-ExecutionPolicy", "Bypass", "-File", "scripts/check-magic-strings.ps1" ]
      },
      {
         "name": "dotnet-build",
         "group": "pre-commit",
         "command": "dotnet",
         "args": [ "build", "ShopManager.sln", "--nologo" ]
      },
      {
         "name": "dotnet-test",
         "group": "pre-commit",
         "command": "dotnet",
         "args": [ "test", "src/backend/ShopManager.Tests/ShopManager.Tests.csproj", "--nologo" ]
      }
   ]
}
