.vs/
.vscode/settings.json
.vscode/.ropeproject
*.user
*.suo
*.userosscache
*.sln.docstates
.idea/
*.DotSettings.user

# ─── Build Output ────────────────────────────────────────────
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
[Aa]ltDebug/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# ─── .NET / NuGet ────────────────────────────────────────────
project.lock.json
project.fragment.lock.json
*.nupkg
*.snupkg
*.nuspec
.nuget/
packages/
!packages/repositories.config
nuget.config
# Rider local cache
*.DotSettings

# ─── Test Results ────────────────────────────────────────────
