*.azurePubxml
*.pubxml
*.publishproj
*.publishsettings
wwwroot/lib/         # Bower/libman managed client libs (restored at build)
wwwroot/.lib/

# ─── Secrets & Credentials (NEVER commit!) ───────────────────
appsettings.Production.json
appsettings.Local.json
appsettings.*.secret.json
*.pem
*.pfx
*.p12
*.key
*.crt
*.env
.env
.env.*
!.env.example
secrets.json
**/secrets.json

